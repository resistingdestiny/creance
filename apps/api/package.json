{
  "name": "@creance/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/main.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts",
    "openapi": "tsx scripts/openapi.ts",
    "test": "vitest run",
    "testnet:bind": "tsx --env-file-if-exists=../../.env scripts/testnet/bind.ts",
    "testnet:x402": "tsx --env-file-if-exists=../../.env scripts/testnet/x402.ts",
    "testnet:audit": "tsx --env-file-if-exists=../../.env scripts/testnet/audit.ts",
    "test:testnet": "pnpm run testnet:bind && pnpm run testnet:x402 && pnpm run testnet:audit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/pg": "^8.23.1",
    "js-yaml": "^4.3.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@creance/client": "workspace:*",
    "@creance/index-model": "workspace:*",
    "@hiero-ledger/sdk": "2.87.0",
    "@worldcoin/idkit-core": "4.2.4",
    "@x402/core": "2.25.0",
    "@x402/fastify": "2.25.0",
    "@x402/hedera": "2.25.0",
    "ethers": "^6.15.0",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "ulid": "^3.0.2"
  }
}
