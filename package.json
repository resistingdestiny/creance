{
  "name": "creance",
  "version": "0.0.0",
  "private": true,
  "description": "Creance: parametric occupation cover funded by Displacement Bond Notes on Hedera testnet",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run && pnpm --filter @creance/contracts run test:hardhat",
    "test:testnet": "pnpm --filter @creance/contracts run test:testnet && pnpm --filter @creance/api run test:testnet",
    "dev": "pnpm --parallel --filter @creance/web --filter @creance/api dev",
    "api:migrate": "pnpm --filter @creance/api run migrate",
    "api:openapi": "pnpm --filter @creance/api run openapi",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "oracle:once": "node scripts/stub.mjs oracle:once",
    "oracle:replay": "node scripts/stub.mjs oracle:replay",
    "oracle:backtest": "pnpm --filter @creance/index-model backtest",
    "oracle:backfill": "pnpm --filter @creance/index-model backfill",
    "oracle:schedule": "node scripts/stub.mjs oracle:schedule",
    "steward:run": "node scripts/stub.mjs steward:run",
    "adjuster:run": "node scripts/stub.mjs adjuster:run",
    "contracts:deploy": "pnpm --filter @creance/contracts run deploy",
    "hedera:setup": "pnpm --filter @creance/contracts run hedera:setup",
    "hedera:schedule": "pnpm --filter @creance/contracts run hedera:schedule",
    "ats:issue": "pnpm --filter @creance/contracts run ats:issue",
    "coupons:pay": "pnpm --filter @creance/contracts run coupons:pay",
    "coupons:mature": "pnpm --filter @creance/contracts run coupons:mature",
    "api:dev": "pnpm --filter @creance/api run dev",
    "demo:seed": "node scripts/stub.mjs demo:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "~10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  }
}
