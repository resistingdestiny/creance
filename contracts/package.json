{
  "name": "@creance/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "hedera:setup": "tsx --env-file-if-exists=../.env scripts/hedera-setup.ts",
    "build": "hardhat build",
    "test": "vitest run && pnpm run test:hardhat",
    "test:hardhat": "hardhat test mocha",
    "typecheck": "hardhat build && tsc --noEmit",
    "deploy": "tsx --env-file-if-exists=../.env scripts/deploy/all.ts",
    "deploy:step": "tsx --env-file-if-exists=../.env scripts/deploy/deploy.ts",
    "verify": "tsx --env-file-if-exists=../.env scripts/deploy/verify.ts",
    "test:testnet": "tsx --env-file-if-exists=../.env scripts/testnet/runthrough.ts",
    "hedera:schedule": "tsx --env-file-if-exists=../.env scripts/hedera/schedule-spike.ts",
    "ats:issue": "tsx --env-file-if-exists=../.env ats/issue.ts",
    "coupons:pay": "tsx --env-file-if-exists=../.env coupons/settle.ts",
    "coupons:mature": "tsx --env-file-if-exists=../.env coupons/mature.ts",
    "demo:release": "tsx --env-file-if-exists=../.env scripts/testnet/release.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "chai": "^5.2.0",
    "ethers": "^6.15.0",
    "hardhat": "^3.15.0",
    "mocha": "^11.7.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@creance/client": "workspace:*",
    "@hashgraph/asset-tokenization-contracts": "8.0.0",
    "@hiero-ledger/sdk": "2.87.0",
    "@openzeppelin/contracts": "5.6.1",
    "@terminal3/ecdsa_vc": "0.1.35",
    "@terminal3/vc_core": "0.0.37",
    "@terminal3/verify_vc": "0.0.39"
  }
}
