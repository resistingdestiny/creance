 items-center justify-between gap-4 py-3 min-h-[52px]"><span class="flex min-w-0 flex-col gap-0.5 text-left"><span class="text-secondary text-ink-2">Index</span></span><span class="flex min-w-0 items-center justify-end gap-2 text-right text-body text-ink">1.10, steady<svg aria-hidden="true" class="text-ink" fill="none" height="16" viewBox="0 0 16 16" width="16"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></span></div></div></div><nav aria-label="Sections" class="flex h-20 items-start border-t border-hairline bg-canvas"><button aria-current="page" class="flex min-h-11 flex-1 items-center justify-center pt-4 text-secondary font-medium text-ink" type="button">Cover</button><button class="flex min-h-11 flex-1 items-center justify-center pt-4 text-secondary font-medium text-ink-2" type="button">Index</button></nav></div></div></div></div></section></main>"`;
