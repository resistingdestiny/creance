# Copy this file to the untracked local environment file at the repository root
# and fill in the blanks. Testnet only. Never commit real values.

# Hedera network name. Only testnet is supported.
HEDERA_NETWORK=testnet
# Operator account id, in 0.0.x form.
HEDERA_OPERATOR_ID=
# Operator private key. Testnet key only.
HEDERA_OPERATOR_KEY=
# JSON-RPC relay used by Hardhat for the Hedera EVM.
HEDERA_RPC_URL=https://testnet.hashio.io/api
# Mirror node REST base, used for reads and receipts.
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com/api/v1

# Postgres connection string for the API.
DATABASE_URL=

# Public origin of the deployed site. Production is https://creance.co.
PUBLIC_SITE_URL=http://localhost:3000

# Registration key for the BLS Public Data API.
BLS_API_KEY=

# World ID app id from the Developer Portal, staging app for the demo.
WORLD_APP_ID=
# World ID action for the eligibility check at purchase.
WORLD_ACTION_ELIGIBILITY=
# World ID action for the check at claim.
WORLD_ACTION_CLAIM=

# Blocky402 facilitator base URL used to settle x402 payments.
BLOCKY402_URL=
