{
  "permissions": {
    "deny": [
      "Bash(git push -f *)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.sh\""
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false
}
